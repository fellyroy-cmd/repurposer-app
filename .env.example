# Copy this file to .env and fill in your real key. Never commit .env.
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5

# Rate limit on /repurpose and /repurpose-all (the token-spending endpoints).
# Defaults below if left blank: 10 requests per 60-second window, per client IP.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Set this on any public deploy (e.g. Render). Visitors must enter it before the
# app will call Claude, so strangers can't spend your credit. Leave blank locally.
ACCESS_CODE=
